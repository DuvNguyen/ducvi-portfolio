{
  "name": "dopefolio",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "watch:scss": "sass sass/main.scss css/style.css --watch",
    "compile:scss": "sass sass/main.scss css/style.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.css -o css/style.css",
    "compress:css": "sass css/style.css css/style.css --style compressed",
    "build": "npm-run-all compile:scss prefix:css compress:css",
    "serve": "browser-sync start --server --files 'css/*.css, *.html, *.js'",
    "dev": "npm-run-all --parallel watch:scss serve"
  },
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "autoprefixer": "^10.3.1",
    "browser-sync": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^8.3.1",
    "sass": "^1.77.0"
  }
}
